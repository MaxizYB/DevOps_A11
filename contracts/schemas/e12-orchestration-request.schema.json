{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MaxizYB/DevOps_A11/contracts/schemas/e12-orchestration-request.schema.json",
  "title": "E11-E12 orchestration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "repo", "base", "target"],
  "properties": {
    "mode": {"enum": ["e11-a", "e11-b", "e12"]},
    "repo": {"type": "string", "minLength": 1},
    "base": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "target": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "candidate": {"type": "string", "minLength": 1},
    "fixed_report": {"type": "string", "minLength": 1},
    "expected_output": {"type": "string", "minLength": 1},
    "build_timeout": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"enum": ["e11-b", "e12"]}}},
     "then": {"required": ["candidate"]}},
    {"if": {"properties": {"mode": {"const": "e11-b"}}},
     "then": {"required": ["fixed_report"]}},
    {"if": {"properties": {"mode": {"const": "e12"}}},
     "then": {"not": {"required": ["fixed_report"]}}}
  ]
}
